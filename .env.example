# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Só as variáveis NEXT_PUBLIC_ vão para o navegador.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública do Supabase (publishable "sb_publishable_..." ou a anon legada)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor
SUPABASE_SERVICE_ROLE_KEY=
# Asaas (pagamento). Sem ASAAS_API_URL, usa o sandbox (testes, sem dinheiro de verdade).
ASAAS_API_KEY=
ASAAS_API_URL=
# Token que você define ao criar o webhook no Asaas (mínimo de 32 caracteres).
ASAAS_WEBHOOK_TOKEN=
# Só "1" depois da confirmação do Augusto para cobrar de verdade (api.asaas.com).
PAYMENTS_LIVE=
