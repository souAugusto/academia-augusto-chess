{
  "name": "academia-augusto-chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:placeholders": "node scripts/check-placeholders.ts",
    "validate:content": "node scripts/validar-conteudo.ts",
    "prebuild": "npm run check:placeholders && npm run validate:content",
    "typecheck": "next typegen && tsc --noEmit",
    "import:puzzles": "node --env-file=.env.local scripts/import-lichess-puzzles.ts",
    "schedule:daily": "node --env-file=.env.local scripts/schedule-daily-puzzles.ts",
    "import:openings": "node --env-file=.env.local scripts/import-openings.ts",
    "seed:phase3": "node --env-file=.env.local scripts/seed-phase3.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "chess.js": "^1.4.0",
    "framer-motion": "13.4.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
